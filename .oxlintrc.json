{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none"
      }
    ],
    "no-dupe-keys": "error",
    "no-undef": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-shadow-restricted-names": "error",
    "no-self-assign": "error",
    "no-useless-concat": "error",
    "no-shadow": "error",
    "unicorn/prefer-add-event-listener": "error",
    "no-console": [
      "error",
      {
        "allow": [
          "error"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "tests/frontend/*.js",
        "playwright.config.js"
      ],
      "env": {
        "node": true,
        "browser": true
      },
      "rules": {
        "no-script-url": "off"
      }
    }
  ]
}
