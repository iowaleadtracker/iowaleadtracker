  },
  "cassette": {
   "name": "Air cassette",
   "text": "A filter that collects particles from the air. A lab measures the lead on it; no results had been posted."
  },
  "dusttrak": {
   "name": "DustTrak",
   "text": "A light-scattering laser photometer that gives real-time readings of the mass of particles in the air (TSI). No readings had been posted."
  },
  "soil": {
   "name": "Soil sample",
   "text": "EPA lists where and when it started sampling soil. No results had been posted."
  },
  "summa": {
   "name": "Summa canister",
   "text": "A specially prepared stainless steel canister that takes in a sample of air for a lab to test for volatile organic compounds (EPA Method TO-15). No results had been posted."
  },
  "xact": {
   "name": "Xact continuous lead monitor",
   "text": "Collects particles from the air on a filter tape and measures their metals by X-ray fluorescence as it runs, so its readings post without a lab. EPA hasn't published the model, inlet size or detection limit."
  }
